{
    "name": "OAuthCredential",
    "type": "object",
    "properties": {
        "provider": {
            "type": "string",
            "enum": [
                "meta"
            ],
            "default": "meta"
        },
        "label": {
            "type": "string"
        },
        "account_external_id": {
            "type": "string"
        },
        "access_token": {
            "type": "string"
        },
        "token_expires_at": {
            "type": "string",
            "format": "date-time"
        },
        "scopes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "status": {
            "type": "string",
            "enum": [
                "active",
                "expired",
                "revoked"
            ],
            "default": "active"
        },
        "last_refreshed_at": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "provider"
    ],
    "rls": {
        "read": false,
        "create": {
            "user_condition": {
                "role": "admin"
            }
        },
        "update": {
            "user_condition": {
                "role": "admin"
            }
        },
        "delete": {
            "user_condition": {
                "role": "admin"
            }
        }
    }
}