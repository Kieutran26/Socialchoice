# Optional server-side local configuration. Defaults require no credentials.
SOCIALCHOICE_API_PORT=3001
SOCIALCHOICE_FRONTEND_PORT=5173
SOCIALCHOICE_DB_PATH=data/socialchoice.sqlite
# Meta secrets belong in server environment variables in Phase B, never VITE_*.
# Create .env.admin with npm run setup:admin. Never put its hash in VITE_*.
# Optional HTTPS origin behind a trusted reverse proxy; requires admin password.
# SOCIALCHOICE_PUBLIC_ORIGIN=https://your-domain.example
# Public hosting only; requires admin hash and absolute persistent database path.
# SOCIALCHOICE_BIND_HOST=0.0.0.0
# SOCIALCHOICE_BACKEND_ORIGIN=https://your-api-host.example
# Facebook connection: server only. Set values in .env.local, never VITE_*.
META_APP_ID=
META_APP_SECRET=
# Use a supported version from your Meta app dashboard, such as vXX.0.
META_GRAPH_VERSION=
# Match the exact Valid OAuth Redirect URI registered in Meta.
META_REDIRECT_URI=http://127.0.0.1:3001/api/meta/callback
# 64 hex characters, generated once locally. Keep stable and back up privately.
META_TOKEN_ENCRYPTION_KEY=
# If Facebook Login for Business in your app requires a login configuration ID:
# META_LOGIN_CONFIG_ID=

# Threads product credentials are distinct from the main Meta App credentials.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:3001/api/threads/callback

# TikTok sandbox: distinct server-only credentials, HTTPS callback only
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://socialchoice.vercel.app/api/tiktok/callback

# Personal LinkedIn (server only)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://socialchoice.vercel.app/api/linkedin/callback

# Optional web AI encryption key: 64 hex characters. Keep stable and private.
# Local runtime can reuse the configured META_TOKEN_ENCRYPTION_KEY if omitted.
# Cloudflare uses SOCIALCHOICE_STORAGE_KEY within each isolated workspace.
SOCIALCHOICE_AI_ENCRYPTION_KEY=
