# Optional server-side local configuration. Defaults require no credentials.
SOCIALCHOICE_API_PORT=3001
SOCIALCHOICE_FRONTEND_PORT=5173
SOCIALCHOICE_DB_PATH=data/socialchoice.sqlite
# Meta secrets belong in server environment variables in Phase B, never VITE_*.
# Create .env.admin with npm run setup:admin. Never put its hash in VITE_*.
# Optional HTTPS origin behind a trusted reverse proxy; requires admin password.
# SOCIALCHOICE_PUBLIC_ORIGIN=https://your-domain.example
