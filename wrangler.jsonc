{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialchoice-api",
  "main": "server/cloudflare-worker.js",
  "account_id": "2e2290be67e66440324d34997c4acf8b",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE",
        "class_name": "SocialchoiceWorkspace"
      },
      {
        "name": "CUSTOMER_DIRECTORY",
        "class_name": "SocialchoiceCustomerDirectory"
      },
      {
        "name": "CUSTOMER_WORKSPACES",
        "class_name": "SocialchoiceCustomerWorkspace"
      },
      {
        "name": "AI_EGRESS",
        "class_name": "SocialchoiceAiEgress"
      }
    ]
  },
  "migrations": [
    {
      "tag": "workspace-storage",
      "new_sqlite_classes": [
        "SocialchoiceWorkspace"
      ]
    },
    {
      "tag": "customer-workspaces",
      "new_sqlite_classes": [
        "SocialchoiceCustomerDirectory",
        "SocialchoiceCustomerWorkspace"
      ]
    },
    {
      "tag": "ai-us-egress",
      "new_sqlite_classes": [
        "SocialchoiceAiEgress"
      ]
    }
  ],
  "vars": {
    "SOCIALCHOICE_PUBLIC_ORIGIN": "https://socialchoice.site",
    "SOCIALCHOICE_BACKEND_ORIGIN": "https://socialchoice-api.nguyenngockieutran.workers.dev",
    "META_APP_ID": "1115808334255427",
    "TIKTOK_REDIRECT_URI": "https://socialchoice.site/api/tiktok/callback",
    "THREADS_APP_ID": "1880622033307199",
    "THREADS_REDIRECT_URI": "https://socialchoice.site/api/threads/callback",
    "META_REDIRECT_URI": "https://socialchoice.site/api/meta/callback",
    "LINKEDIN_CLIENT_ID": "86aryvxxw7a5q8",
    "LINKEDIN_REDIRECT_URI": "https://socialchoice.site/api/linkedin/callback",
    "X_REDIRECT_URI": "https://socialchoice.site/api/x/callback",
    "SOCIALCHOICE_AUTOPILOT_ENABLED": "true"
  },
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "AUTOPILOT_ASSETS",
      "bucket_name": "socialchoice-autopilot-production"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUTOPILOT_QUEUE",
        "queue": "socialchoice-autopilot-production"
      }
    ],
    "consumers": [
      {
        "queue": "socialchoice-autopilot-production",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "max_concurrency": 1,
        "dead_letter_queue": "socialchoice-autopilot-production-dlq"
      }
    ]
  }
}
