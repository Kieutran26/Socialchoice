{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialchoice-api",
  "main": "server/cloudflare-worker.js",
  "account_id": "2e2290be67e66440324d34997c4acf8b",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "SocialchoiceWorkspace" },
      { "name": "CUSTOMER_DIRECTORY", "class_name": "SocialchoiceCustomerDirectory" },
      { "name": "CUSTOMER_WORKSPACES", "class_name": "SocialchoiceCustomerWorkspace" }
    ]
  },
  "migrations": [
    { "tag": "workspace-storage", "new_sqlite_classes": ["SocialchoiceWorkspace"] },
    { "tag": "customer-workspaces", "new_sqlite_classes": ["SocialchoiceCustomerDirectory", "SocialchoiceCustomerWorkspace"] }
  ],
  "vars": {
    "SOCIALCHOICE_PUBLIC_ORIGIN": "https://socialchoice.vercel.app",
    "SOCIALCHOICE_BACKEND_ORIGIN": "https://socialchoice-api.nguyenngockieutran.workers.dev",
    "META_APP_ID": "1115808334255427",
    "TIKTOK_REDIRECT_URI": "https://socialchoice.vercel.app/api/tiktok/callback",
    "THREADS_APP_ID": "1880622033307199",
    "THREADS_REDIRECT_URI": "https://socialchoice.vercel.app/api/threads/callback",
    "META_REDIRECT_URI": "https://socialchoice.vercel.app/api/meta/callback"
  },
  "observability": { "enabled": false }
}
